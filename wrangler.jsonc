{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sidemannen",
  "pages_build_output_dir": "./dist/client",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {"binding": "DB", "database_name": "sidekick-inquiries", "database_id": "6b860980-c6f4-431f-a4d3-07df12007039", "migrations_dir": "./migrations"}
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {"binding": "DB", "database_name": "sidemannen-preview", "database_id": "e4fc1479-29f2-4443-9e86-19b1b56e4b42", "migrations_dir": "./migrations"}
      ]
    }
  }
}
